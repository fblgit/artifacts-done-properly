{
  "component": "canvas",
  "file": "kit/canvas.js",
  "about": "A canvas with one canvas doc and three elements, no refs: tool rail, pen colours, zoom.",
  "store": {
    "lsPrefix": "demo",
    "state": {
      "conn": "live",
      "canWrite": true,
      "me": "u1",
      "scopeId": "s1"
    }
  },
  "db": {
    "pathTemplate": "scopes/{scope}/{name}",
    "scopeSlot": "scopeId"
  },
  "chrome": {},
  "canvas": {
    "colors": [
      "ink",
      "blue"
    ],
    "tints": [
      "yellow"
    ],
    "scopeSlot": "scopeId"
  },
  "data": {
    "canvases": {
      "c1": {
        "name": "Main",
        "order": 1,
        "created": 1
      }
    },
    "els": {
      "e1": {
        "canvasId": "c1",
        "type": "rect",
        "x": 40,
        "y": 40,
        "w": 180,
        "h": 90,
        "fill": "none",
        "text": "Hello",
        "color": "ink",
        "sw": 3,
        "z": 1
      },
      "e2": {
        "canvasId": "c1",
        "type": "sticky",
        "x": 300,
        "y": 60,
        "w": 200,
        "h": 140,
        "tint": "yellow",
        "text": "A note",
        "z": 2
      },
      "e3": {
        "canvasId": "c1",
        "type": "arrow",
        "x": 220,
        "y": 85,
        "x2": 300,
        "y2": 110,
        "color": "blue",
        "sw": 3,
        "z": 3
      }
    }
  },
  "render": [
    "CanvasView"
  ],
  "expect": {
    "selectors": [
      ".cv .cv-bar",
      ".surface svg.layer",
      ".toolrail",
      ".zoom",
      ".el-sticky"
    ]
  }
}
