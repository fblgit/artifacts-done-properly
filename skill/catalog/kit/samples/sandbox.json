{
  "component": "sandbox",
  "file": "kit/patterns/sandbox.js",
  "about": "Invented detectors over invented text, and six simulated probes with a timeout.",
  "label": "Text to test",
  "note": "These are approximations of real rules. Edge cases can differ.",
  "text": "Pickup for ORD-48213, contact anna.sample@mail.invalid, card ending 4242 4242 4242 4242",
  "detectors": [
    { "id": "private-key", "label": "Private key block", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----" },
    { "id": "access-key", "label": "Access key id", "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b" },
    { "id": "token-prefix", "label": "Token with a known prefix", "pattern": "\\b(?:tok|key|sec)_[A-Za-z0-9]{16,}\\b" },
    { "id": "basic-auth", "label": "Password inside a URL", "pattern": "[a-z]+://[^/:@\\s]+:[^/@\\s]+@[^/\\s]+", "flags": "i" },
    { "id": "assignment", "label": "Secret assigned in text", "pattern": "(?:password|secret|api[_-]?key|token)[\"']?\\s*[:=]\\s*[\"']?([^\\s\"',}{]{6,})", "flags": "i", "group": 1 },
    { "id": "card", "label": "Card number", "pattern": "\\b(?:\\d{4}[ -]?){3}\\d{4}\\b" },
    { "id": "email", "label": "Email address", "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}" },
    { "id": "order", "label": "Order number", "pattern": "\\bORD-\\d{5}\\b" },
    { "id": "random", "label": "Long random string (by entropy)", "pattern": "[A-Za-z0-9_+/=-]{20,64}", "minEntropy": 3.8, "needDigit": true }
  ],
  "examples": [
    { "id": "order", "label": "An order line", "text": "Pickup for ORD-48213, contact anna.sample@mail.invalid, card ending 4242 4242 4242 4242" },
    { "id": "key", "label": "A key in a config", "text": "api_key = tok_Zk3p9QwXr7LmN2vB5cD8\nregion = north" },
    { "id": "url", "label": "A URL with a password", "text": "mirror: https://deploy:hunter22pass@files.example.invalid/builds" },
    { "id": "plain", "label": "Plain words", "text": "Two seeded loaves for Saturday, please." }
  ],
  "probes": [
    { "id": "page", "what": "Fetch a page from the same site", "target": "./menu.json", "ms": 140, "outcome": "pass", "detail": "HTTP 200, 3.1 KB" },
    { "id": "cdn", "what": "Fetch a file from an allowed CDN", "target": "cdn.example.invalid/lib.json", "ms": 320, "outcome": "pass", "detail": "HTTP 200, lib 2.4.1" },
    { "id": "other", "what": "Fetch from another server", "target": "api.example.invalid/status", "ms": 60, "outcome": "fail", "detail": "Blocked by the page's security policy" },
    { "id": "stream", "what": "Open a live stream", "target": "stream.example.invalid/events", "ms": 480, "outcome": "pass", "detail": "received an event" },
    { "id": "socket", "what": "Open a WebSocket", "target": "wss://echo.example.invalid", "ms": 90, "outcome": "fail", "detail": "connection failed" },
    { "id": "local", "what": "Reach a service on this computer", "target": "http://127.0.0.1:8090/health", "ms": 99999, "outcome": "hang", "detail": "" }
  ]
}
