{
  "component": "store",
  "file": "kit/store.js",
  "about": "State object, subscribe hook and the db write layer on their own: create a store and a db, write one document, see it in state.",
  "store": { "lsPrefix": "demo", "state": { "conn": "connecting", "canWrite": true, "scopeId": "s1", "notes": {} } },
  "toast": "console",
  "db": { "pathTemplate": "scopes/{scope}/{name}", "scopeSlot": "scopeId", "caps": [] },
  "run": [
    { "call": "newId", "args": ["notes"], "as": "id" },
    { "call": "put", "args": ["notes", "$id", { "text": "hello" }] },
    { "call": "localSet", "args": ["notes", "$id", { "text": "hello" }] }
  ],
  "expect": { "state": "notes has one entry whose text is hello", "db": "scopes/s1/notes/<id> holds { text: hello }" }
}
