   },
   {
    "tone": "ok",
    "k": "Verified",
    "body": "The new shelves held at cone 6 for three firings without warping."
   },
   {
    "tone": "warn",
    "k": "Check first",
    "body": "The vent fan runs off the kiln room's own breaker. Switch it on before you start a firing."
   },
   {
    "tone": "danger",
    "k": "Stop",
    "body": "Never open the kiln above 200 °C. Thermal shock cracks the shelves and the pots."
   },
