{
  "note": "Invented. The kit's three rules (root, ns/shared and each viewer's own ns/users/{self}), two locked prefixes, twelve part ids with titles, and a user who can edit.",
  "rules": [
    {
      "path": "",
      "read": "view",
      "write": "admin"
    },
    {
      "path": "ns/shared",
      "read": "view",
      "write": "interact"
    },
    {
      "path": "ns/users/{self}",
      "read": "view",
      "write": "interact"
    }
  ],
  "locks": [
    "core",
    "page.header"
  ],
  "user": {
    "canEdit": true
  },
  "parts": [
    "core.nav",
    "core.footer",
    "page.header",
    "page.header.title",
    "page.header.search",
    "page.intro",
    "page.script.main",
    "page.style.main",
    "page.table.rooms",
    "page.table.bookings",
    "page.notes",
    "page.contact"
  ],
  "titles": {
    "core.nav": "Site navigation",
    "core.footer": "Footer links",
    "page.header": "Page header",
    "page.header.title": "Header title",
    "page.header.search": "Header search",
    "page.intro": "Introduction",
    "page.script.main": "Page script",
    "page.style.main": "Page style",
    "page.table.rooms": "Rooms table",
    "page.table.bookings": "Bookings table",
    "page.notes": "Notes",
    "page.contact": "Contact form"
  }
}
